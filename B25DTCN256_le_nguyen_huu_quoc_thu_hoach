# Khởi tạo sẵn danh sách cầu thủ dạng List chứa các Dictionary
danh_sach = [
    {"ma_ct": "CR7", "ten_ct": "Ronaldo", "so_tran": 20, "ban_thang": 15, "kien_tao": 5, "diem_thanh_tich": 35, "danh_hieu": "Bạc"},
    {"ma_ct": "M10", "ten_ct": "Messi", "so_tran": 18, "ban_thang": 22, "kien_tao": 10, "diem_thanh_tich": 54, "danh_hieu": "Vàng"}
]

# Hàm tính điểm thành tích và danh hiệu
def tinh_diem_va_danh_hieu(ban_thang, kien_tao):
    diem = (ban_thang * 2) + kien_tao
    if diem > 40:
        danh_hieu = "Vàng"
    elif diem > 20:
        danh_hieu = "Bạc"
    else:
        danh_hieu = "Đồng"
    return diem, danh_hieu

while True:
    # HIỂN THỊ MENU
    print("\n--- MENU CHỨC NĂNG ---")
    print("1. Hiển thị danh sách")
    print("2. Thêm mới cầu thủ")
    print("3. Cập nhật thông tin")
    print("4. Xoá cầu thủ")
    print("5. Tìm kiếm cầu thủ")
    print("6. Sắp xếp danh sách")
    print("7. Thống kê danh hiệu")
    print("8. Thống kê số lượng")
    print("9. Cầu thủ danh hiệu Max/Min")
    print("10. Thoát")
    
    chon = input("Chọn chức năng (1-10): ").strip()
    
    if chon == "1":
        print(f"\n{'Mã CT':<10}{'Tên Cầu Thủ':<15}{'Bàn Thắng':<12}{'Kiến Tạo':<10}{'Điểm TT':<10}{'Danh Hiệu'}")
        print("-" * 70)
        for ct in danh_sach:
            print(f"{ct['ma_ct']:<10}{ct['ten_ct']:<15}{ct['ban_thang']:<12}{ct['kien_tao']:<10}{ct['diem_thanh_tich']:<10}{ct['danh_hieu']}")

    elif chon == "2":
        ma = input("Nhập Mã CT: ").strip().upper()
        if any(ct['ma_ct'] == ma for ct in danh_sach):
            print("Lỗi: Mã cầu thủ đã tồn tại!")
            continue
        tên = input("Nhập Tên: ").strip()
        sotran = int(input("Nhập Số trận: "))
        banthang = int(input("Nhập Số bàn thắng: "))
        kientao = int(input("Nhập Số kiến tạo: "))
        
        diem, danh_hieu = tinh_diem_va_danh_hieu(banthang, kientao)
        danh_sach.append({
            "ma_ct": ma, "ten_ct": tên, "so_tran": sotran,
            "ban_thang": banthang, "kien_tao": kientao,
            "diem_thanh_tich": diem, "danh_hieu": danh_hieu
        })
        print("Thêm thành công!")

    elif chon == "3":
        ma = input("Nhập Mã CT cần cập nhật: ").strip().upper()
        for ct in danh_sach:
            if ct['ma_ct'] == ma:
                ct['ban_thang'] = int(input("Nhập số Bàn thắng mới: "))
                ct['kien_tao'] = int(input("Nhập số Kiến tạo mới: "))
                ct['diem_thanh_tich'], ct['danh_hieu'] = tinh_diem_va_danh_hieu(ct['ban_thang'], ct['kien_tao'])
                print("Cập nhật thành công!")
                break
        else:
            print("Không tìm thấy cầu thủ.")

    elif chon == "4":
        ma = input("Nhập Mã CT cần xóa: ").strip().upper()
        for ct in danh_sach:
            if ct['ma_ct'] == ma:
                xac_nhan = input("Bạn có chắc muốn xóa không? (Y/N): ").strip().upper()
                if xac_nhan == "Y":
                    danh_sach.remove(ct)
                    print("Đã xóa!")
                break
        else:
            print("Không tìm thấy.")

    elif chon == "5":
        tk = input("Nhập Tên hoặc Mã cần tìm: ").strip().lower()
        for ct in danh_sach:
            if tk in ct['ten_ct'].lower() or tk == ct['ma_ct'].lower():
                print(f"Tìm thấy: {ct['ma_ct']} - {ct['ten_ct']} | Điểm: {ct['diem_thanh_tich']} | Danh hiệu: {ct['danh_hieu']}")

    elif chon == "6":
        print("1. Xếp theo Điểm giảm dần | 2. Xếp theo Bàn thắng giảm dần")
        tc = input("Chọn (1 hoặc 2): ")
        key_sort = 'diem_thanh_tich' if tc == "1" else 'ban_thang'
        ds_sx = sorted(danh_sach, key=lambda x: x[key_sort], reverse=True)
        for ct in ds_sx:
            print(f"{ct['ma_ct']} - {ct['ten_ct']} - {ct[key_sort]}")

    elif chon == "7" or chon == "8":
        v = sum(1 for ct in danh_sach if ct['danh_hieu'] == "Vàng")
        b = sum(1 for ct in danh_sach if ct['danh_hieu'] == "Bạc")
        d = sum(1 for ct in danh_sach if ct['danh_hieu'] == "Đồng")
        print(f"Thống kê: Vàng: {v} | Bạc: {b} | Đồng: {d}")

    elif chon == "9":
        if danh_sach:
            ranks = {"Vàng": 3, "Bạc": 2, "Đồng": 1}
            max_ct = max(danh_sach, key=lambda x: ranks[x['danh_hieu']])
            min_ct = min(danh_sach, key=lambda x: ranks[x['danh_hieu']])
            print(f"Danh hiệu cao nhất: {max_ct['ten_ct']} ({max_ct['danh_hieu']})")
            print(f"Danh hiệu thấp nhất: {min_ct['ten_ct']} ({min_ct['danh_hieu']})")

    elif chon == "10":
        print("Tạm biệt!")
        break
    else:
        print("Lựa chọn sai, vui lòng nhập lại.")